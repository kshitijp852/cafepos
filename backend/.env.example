# MongoDB Connection
MONGO_URL=mongodb://localhost:27017
DB_NAME=pos_database

# CORS Configuration
# Comma-separated list of allowed origins. Do NOT use "*" together with
# credentialed requests — browsers reject that combination.
CORS_ORIGINS=http://localhost:3000

# JWT Configuration
# Generate a strong secret, e.g.:  python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change-me-generate-a-64-char-hex-secret
JWT_ALGORITHM=HS256
JWT_EXPIRY_HOURS=24

# Frontend base URL — used to build password-reset links in emails.
FRONTEND_BASE_URL=http://localhost:3000

# Email (Gmail SMTP) for signup OTP + password-reset links.
# Leave SMTP_USER / SMTP_APP_PASSWORD empty to run in DEV mode: emails are
# logged instead of sent, and the OTP / reset link is returned in the API
# response so you can test signup + reset without a real mailbox.
# For Gmail, create an App Password (Google Account → Security → App passwords).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_APP_PASSWORD=
SMTP_FROM=
SMTP_FROM_NAME=Cafe POS

# OTP / reset-token lifetimes (minutes).
OTP_EXPIRY_MINUTES=10
OTP_MAX_ATTEMPTS=5
RESET_TOKEN_EXPIRY_MINUTES=30

# Waiter device-pairing code lifetime (minutes).
DEVICE_CODE_EXPIRY_MINUTES=15

# RapidAPI key for pincode -> city/state lookup (pincode.p.rapidapi.com).
# Server-side only; leave empty to disable the lookup.
RAPIDAPI_KEY=

# Shared secret that lets a signup skip the mandatory GST number (demo/QA
# accounts only). Leave empty in production to disable the bypass entirely.
TEST_SIGNUP_CODE=
